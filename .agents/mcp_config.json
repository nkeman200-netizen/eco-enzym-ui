{
  "mcpServers": {
    "agent-lsp": {
      "command": "npx",
      "args": ["-y", "agent-lsp@latest"],
      "cwd": "."
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "cwd": "."
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"],
      "cwd": ".",
      "env": {
        "PLAYWRIGHT_HEADLESS": "true"
      }
    }
  }
}
